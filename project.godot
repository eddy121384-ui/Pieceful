; Engine configuration file.
; Piecepace: Jigsaw Puzzles — V0-02 basic puzzle workspace.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Piecepace: Jigsaw Puzzles"
run/main_scene="res://main.tscn"

[display]

; Keep the render target truly fixed at 720x720. Main and SortingUI continue to
; lay out in virtual landscape/portrait coordinates and pre-compensate the long
; axis before this final viewport stretch. Physical rotation therefore scales one
; composed surface instead of resizing/rebinding the 1,000+ CanvasItems used by
; dense puzzle modes.
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="ignore"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.082, 0.09, 1)
