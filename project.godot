; Engine configuration file.
; Piecepace: Jigsaw Puzzles — V0-02 basic puzzle workspace.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Piecepace: Jigsaw Puzzles"
run/main_scene="res://main.tscn"

[display]

; Dense-orientation A/B: render through a fixed logical viewport surface first,
; then scale the composed result to the physical window. This tests whether
; root CanvasItem resize churn can be isolated by Godot's viewport stretch path.
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.082, 0.09, 1)
