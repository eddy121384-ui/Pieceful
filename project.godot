; Engine configuration file.
; Piecepace: Jigsaw Puzzles — V0-02 basic puzzle workspace.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Piecepace: Jigsaw Puzzles"
run/main_scene="res://main.tscn"

[display]

; Diagnostic only: keep the render target at a true fixed 720x720 while the
; physical window changes shape. aspect=ignore will visibly distort output; the
; goal is only to isolate whether fixed render-target dimensions remove the
; dense CanvasItem orientation hitch.
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="ignore"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.082, 0.09, 1)
